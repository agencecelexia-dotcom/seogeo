# Copy to .env.local for Node development; set values in Vercel Project Settings for deployment.
RUNTIME_PLATFORM=vercel
AUTH_MODE=password
DATABASE_PROVIDER=postgres
# Pooled PostgreSQL URL from the Vercel Marketplace integration (Neon, etc.).
DATABASE_URL=
# Optional direct URL for migrations; otherwise DATABASE_URL is used.
POSTGRES_DATABASE_URL=
# Optional pool size 1..3 (default 3). Use 1 with local PGlite.
POSTGRES_POOL_MAX=
# Explicit locally and in previews; production can use VERCEL_PROJECT_PRODUCTION_URL.
BETTER_AUTH_URL=https://your-project.vercel.app
BETTER_AUTH_SECRET=
OPENSEO_OPERATOR_SECRET=
CRON_SECRET=
# Create a PRIVATE Blob store. Never use a public store for private reports.
BLOB_READ_WRITE_TOKEN=
OPENSEO_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
# Optional source integrations, configured only when needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATAFORSEO_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=
CRAWLER_ACCESS_SECRET=
